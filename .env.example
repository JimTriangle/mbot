# Configuration Binance API
# Obtenez vos clés API sur https://www.binance.com/fr/my/settings/api-management
BINANCE_API_KEY=votre_cle_api_ici
BINANCE_API_SECRET=votre_secret_api_ici

# Mode de fonctionnement
# true = utiliser le testnet (recommandé pour les tests)
# false = utiliser l'environnement de production (ATTENTION: argent réel)
TESTNET=true

# Mode dry-run
# true = simuler les trades sans passer d'ordres réels (recommandé)
# false = passer de vrais ordres (ATTENTION: argent réel)
DRY_RUN=true

# Configuration du bot (optionnel, utilisé par spot_btcusd.py)
SYMBOL=BTCUSDT
